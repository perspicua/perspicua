.ifndef _MMIO_INC_
.equ _MMIO_INC_, 1

.equ PERIPHERAL_BASE, 0xFE000000

.equ UART0_BASE, (PERIPHERAL_BASE + 0x201000)
.equ UART0_DR,   (UART0_BASE + 0x00)
.equ UART0_FR,   (UART0_BASE + 0x18)
.equ UART0_IBRD, (UART0_BASE + 0x24)
.equ UART0_FBRD, (UART0_BASE + 0x28)
.equ UART0_LCHR, (UART0_BASE + 0x2C)
.equ UART0_CR,   (UART0_BASE + 0x30)
.equ UART0_ICR,  (UART0_BASE + 0x44)

.equ GPIO_BASE,     (PERIPHERAL_BASE + 0x200000)
.equ GPIO_GPFSEL0,  (GPIO_BASE + 0x00)
.equ GPIO_GPPUPDN0, (GPIO_BASE + 0xE4)

.endif
