/*
 * config.h - Build configuration, generated by CMake from cmake/config.h.in.
 *
 * Do not edit: the option list lives in the top-level CMakeLists.txt, and this
 * is the only place the chosen values are written down. It is force-included
 * (-include) into everything compiled as kernel code, so a header like
 * arch/cpu.h cannot be read with one value in the kernel and another in libk.
 */

#ifndef PERSPICUA_CONFIG_H
#define PERSPICUA_CONFIG_H

#cmakedefine CONFIG_SMP
#cmakedefine CONFIG_LOCKDEP
#cmakedefine CONFIG_TESTS

#define CONFIG_NR_CPUS       @CONFIG_NR_CPUS@
#define CONFIG_MAX_PROCESSES @CONFIG_MAX_PROCESSES@
#define CONFIG_MAX_FDS       @CONFIG_MAX_FDS@

#endif // PERSPICUA_CONFIG_H
